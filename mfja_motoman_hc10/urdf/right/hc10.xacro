<?xml version="1.0"?>
<robot name="yaskawa_L" xmlns:xacro="[http://www.ros.org/wiki/xacro](http://www.ros.org/wiki/xacro)">

    <!-- Materials -->
    <xacro:include filename="$(find motoman_hc10_moveit_config)/urdf/materials.xacro" />

    <!-- Gripper / Tooling Includes -->
    <xacro:include filename="$(find motoman_hc10_moveit_config)/urdf/left/pince.xacro" />

    <!-- Robot Arm Macro -->
    <xacro:include filename="$(find motoman_hc10_moveit_config)/urdf/hc10dt_b10_macro.xacro" />
    <xacro:motoman_hc10dt_b10 prefix=""/>

    <!-- Base Link Kinematic Reference -->
    <!-- (Gazebo or Launch file can spawn base_link directly at desired pose, or attach to world) -->
    <link name="world"/>
    <joint name="world_robot_joint" type="fixed">
        <!-- Calculated relative offset combining previous world -> table -> base_link transforms -->
        <origin xyz="0.171 0.203 0.613" rpy="0 0 0"/>
        <parent link="world"/>
        <child link="base_link"/>
    </joint>

    <!-- End-Effector / Tool Adapter Attachment -->
    <joint name="tool_adapter_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.57079 0 -1.57079" />
        <parent link="tool0" />
        <child link="adaptater_plate_link" />
    </joint>

</robot>