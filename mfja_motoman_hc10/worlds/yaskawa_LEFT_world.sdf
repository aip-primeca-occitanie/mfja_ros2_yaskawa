<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="yaskawa_LEFT_world">
    
    <!-- Sun Light Source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Cell Structure / Enclosure -->
    <model name="cell_structure">
      <static>true</static>
      <pose>0.72 0.27 0.698 0 0 -1.57079</pose>
      <link name="cell_link">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>package://motoman_hc10_moveit_config/meshes/left/cell.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>package://motoman_hc10_moveit_config/meshes/left/cell.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Workstation Table -->
    <model name="work_table">
      <static>true</static>
      <pose>0 0 0.432 1.57079 0 0</pose>
      <link name="table_link">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>package://motoman_hc10_moveit_config/meshes/table.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>package://motoman_hc10_moveit_config/meshes/table.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>